# Browser-visible backend URL.
# Local dev backend defaults to http://localhost:5001.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Where the public marketing forms (waitlist + "3 free leads") are emailed.
# Kept out of source because this repository is public. Set the same value in
# your hosting provider's environment variables before deploying.
FORWARD_TO=you@example.com

# Optional: override the forwarding service entirely (defaults to FormSubmit).
# FORM_ENDPOINT=https://formsubmit.co/ajax/you@example.com
